{%- macro tile(id, p, view) -%}
{%- set style = p.css[view] if p.css else none -%}
            <div class="art-image"{% if style %} style="{{ style }}"{% endif %}>
                {%- if p.video %}
                <video autoplay loop muted playsinline{% if p.poster %} poster="{{ p.poster }}"{% endif %} src="{{ p.src }}" type="video/mp4" data-group="{{ id }}" data-caption="{{ p.caption }}"></video>
                {%- else %}
                <img src="{{ p.src }}" alt="{{ p.alt }}" data-group="{{ id }}" data-caption="{{ p.caption }}">
                {%- endif %}
                {%- if p.label %}
                <div class="image-label">{{ p.label }}</div>
                {%- endif %}
            </div>
{%- endmacro -%}
